root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{java,xml,fxml,css}]
indent_style = space
indent_size = 4

[*.{yml,yaml}]
indent_style = space
indent_size = 2

[*.{md,txt}]
trim_trailing_whitespace = false

[*.{cmd,bat}]
end_of_line = crlf

[src/main/resources/db/migration/*.sql]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
